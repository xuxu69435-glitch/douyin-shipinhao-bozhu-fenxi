{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Douyin Analyst",
  "version": "0.1.4",
  "identifier": "com.douyinanalyst.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "抖音博主内容分析", "width": 1280, "height": 850, "minWidth": 920, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "compression": "zlib" } },
    "externalBin": ["binaries/douyin-analyst-backend"],
    "resources": { "binaries/runtime/_internal/": "_internal/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
